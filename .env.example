# SWAP environment — names only, never commit real values.

# PostgreSQL (16+) — dedicated SWAP database
DATABASE_URL=postgres://swap:swap@127.0.0.1:5432/swap

# Public origin used for absolute URLs (OG tags, sitemap, password-reset links)
APP_URL=http://localhost:3100

# Storage driver: "local" (./storage, served by /api/files — single node/dev only) or "supabase"
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=swap

# SWAP Inspect desktop agent ingestion (see docs/05-INSPECTION-AGENT.md)
INSPECTION_AGENT_ENABLED=false
INSPECTION_AGENT_SECRET=

# Never set these in production unless it's a private staging environment:
# ALLOW_DEMO_SEED=false       (allow `pnpm db:seed` against a non-local database)
# ALLOW_DEMO_ACCOUNTS=false   (allow @swap.example demo logins when NODE_ENV=production)
# ALLOW_TEST_SMS=false        (local/CI only: SMS_PROVIDER=outbox writes codes to ./.sms-outbox; refused on Vercel/non-localhost)

# ── Phone authentication (Saudi mobile numbers, SMS one-time codes) — see docs/08-PHONE-AUTH-AND-GUARD.md
# Without a working provider, phone sign-up/sign-in stays unavailable (nothing is faked).
# HMAC key for codes and IP hashes. 32+ random characters; REQUIRED in production.
OTP_SECRET=
# unifonic | twilio   (outbox is for automated tests only)
SMS_PROVIDER=
# Explicit approval to send paid SMS. Keep false until the provider account, sender ID and budget are approved.
SMS_DELIVERY_ENABLED=false
# Hard cap on codes sent per UTC day across the site (cost ceiling).
SMS_DAILY_CAP=500
# Unifonic (Saudi; requires a CST-registered sender ID)
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=
# Twilio (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
