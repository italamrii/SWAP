# Names only — never commit real secrets.
DATABASE_URL=postgres://swap:swap@127.0.0.1:5432/swap
# Public origin used for absolute URLs (OG tags, sitemap, reset links)
APP_URL=http://localhost:3100
# Storage driver: "local" (writes to ./storage, served by /api/files) or "s3"
STORAGE_DRIVER=local
# S3-compatible storage (Supabase Storage / Cloudflare R2) — used when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Accept payloads from the future desktop inspection agent
INSPECTION_AGENT_ENABLED=false
INSPECTION_AGENT_SECRET=
