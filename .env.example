# SWAP environment — names only, never commit real values.

# PostgreSQL (16+) — dedicated SWAP database
DATABASE_URL=postgres://swap:swap@127.0.0.1:5432/swap

# Public origin used for absolute URLs (OG tags, sitemap, password-reset links)
APP_URL=http://localhost:3100

# Storage driver: "local" (./storage, served by /api/files — single node/dev only) or "supabase"
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=swap

# SWAP Inspect desktop agent ingestion (see docs/05-INSPECTION-AGENT.md)
INSPECTION_AGENT_ENABLED=false
INSPECTION_AGENT_SECRET=
